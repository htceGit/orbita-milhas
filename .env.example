# Apenas estas duas variáveis públicas são incorporadas ao HTML/JS.
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secrets do GitHub Actions; nunca no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FLIGHTS_PROXY=

# API privada opcional (não colocar esta credencial no navegador).
# Gere localmente: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CALENDAR_API_TOKEN=
# Somente para desenvolvimento com Chrome já instalado; no Actions usa Chromium.
CALENDAR_BROWSER_CHANNEL=
